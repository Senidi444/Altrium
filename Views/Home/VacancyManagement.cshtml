@model List<AltriumRecruitmentSystem.Models.Vacancy>

@{
    ViewData["Title"] = "Vacancy Management";
}

<div class="dashboard-layout">

    <aside class="dashboard-sidebar">
        <a asp-controller="Home" asp-action="RecruiterDashboard" class="sidebar-link">Dashboard</a>
        <a href="#" class="sidebar-link active">Vacancies</a>
        <a asp-controller="Home" asp-action="ApplicantsManagement" class="sidebar-link">Applications</a>
        <a asp-controller="Home" asp-action="ScheduleInterview" class="sidebar-link">Interviews</a>
        <a asp-controller="Home" asp-action="Logout" class="sidebar-link">Logout</a>
    </aside>

    <main class="dashboard-main">

        <div class="table-header-row">
            <h1>Manage Vacancies</h1>
            <a asp-controller="Home" asp-action="CreateVacancy" class="create-button">+ Create Vacancy</a>
        </div>

        <table class="dashboard-table">
            <thead>
                <tr>
                    <th>Job Title</th>
                    <th>Department</th>
                    <th>Posted On</th>
                    <th>Applications</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="color:var(--grey);">No vacancies created yet.</td>
                    </tr>
                }
                @foreach (var vacancy in Model)
                {
                    <tr>
                        <td>@vacancy.JobTitle</td>
                        <td>@vacancy.Department</td>
                        <td>@vacancy.PostedOn.ToString("dd MMM yyyy")</td>
                        <td>@vacancy.Applications.Count</td>
                        <td>
                            <div class="table-actions">
                                <form asp-controller="Home" asp-action="DeleteVacancy" method="post">
                                    <input type="hidden" name="id" value="@vacancy.VacancyId" />
                                    <button type="submit" class="delete-icon">🗑</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </main>

</div>