@model List<AltriumRecruitmentSystem.Models.JobApplication>

@{
    ViewData["Title"] = "Applicant Dashboard";

    var fullName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
    var firstName = fullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .FirstOrDefault() ?? "";

    var initials = string.Join("", fullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(n => n[0]));

    string StatusClass(AltriumRecruitmentSystem.Models.ApplicationStatus status) => status switch
    {
        AltriumRecruitmentSystem.Models.ApplicationStatus.Applied => "status-applied",
        AltriumRecruitmentSystem.Models.ApplicationStatus.UnderReview => "status-review",
        AltriumRecruitmentSystem.Models.ApplicationStatus.Shortlisted => "status-shortlisted",
        AltriumRecruitmentSystem.Models.ApplicationStatus.Rejected => "status-rejected",
        _ => "status-applied"
    };

    var totalApplications = ViewBag.TotalApplications ?? 0;
    var underReviewCount = ViewBag.UnderReviewCount ?? 0;
    var shortlistedCount = ViewBag.ShortlistedCount ?? 0;
    var rejectedCount = ViewBag.RejectedCount ?? 0;
    var unreadNotifications = ViewBag.UnreadNotifications ?? 0;

    var scheduledInterview = Model
        .Where(a => a.Interview != null)
        .FirstOrDefault();
}

<div class="dashboard-layout">

    <aside class="dashboard-sidebar">

        <a asp-controller="Home"
           asp-action="ApplicantDashboard"
           class="sidebar-link active">
            Dashboard
        </a>

        <a asp-controller="Home"
           asp-action="CompleteProfile"
           class="sidebar-link">
            Profile
        </a>

        <a asp-controller="Home"
           asp-action="UploadCV"
           class="sidebar-link">
            Upload CV
        </a>

        <a asp-controller="Home"
           asp-action="BrowseVacancies"
           class="sidebar-link">
            Vacancies
        </a>

        <a asp-controller="Home"
           asp-action="MyApplications"
           class="sidebar-link">
            Applications
        </a>

        <a asp-controller="Home"
           asp-action="Notifications"
           class="sidebar-link">

            Notifications

            @if (unreadNotifications > 0)
            {
                <span class="badge bg-warning text-dark ms-1">
                    @unreadNotifications
                </span>
            }

        </a>

        <form asp-controller="Home"
              asp-action="Logout"
              method="post">

            <button type="submit"
                    class="sidebar-link"
                    style="background:none; border:0; width:100%; text-align:left;">

                Logout

            </button>

        </form>

    </aside>


    <main class="dashboard-main">

        <div class="dashboard-welcome">

            <h1>Welcome, @firstName!</h1>

            <div class="dashboard-user">

                <div class="dashboard-avatar">
                    @initials
                </div>

                @fullName · Applicant

            </div>

        </div>


        <!-- APPLICATION STATISTICS -->

        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-number">
                    @totalApplications
                </div>

                <div class="stat-label">
                    Applications
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-number">
                    @underReviewCount
                </div>

                <div class="stat-label">
                    Under Review
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-number">
                    @shortlistedCount
                </div>

                <div class="stat-label">
                    Shortlisted
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-number">
                    @rejectedCount
                </div>

                <div class="stat-label">
                    Rejected
                </div>

            </div>

        </div>


        <!-- QUICK ACTIONS -->

        <div class="dashboard-section">

            <h2>Quick Actions</h2>

            <div class="quick-actions">

                <a asp-controller="Home"
                   asp-action="CompleteProfile"
                   class="action-card">

                    <div class="action-icon">👤</div>
                    Complete Profile

                </a>


                <a asp-controller="Home"
                   asp-action="UploadCV"
                   class="action-card">

                    <div class="action-icon">⬆</div>
                    Upload CV

                </a>


                <a asp-controller="Home"
                   asp-action="BrowseVacancies"
                   class="action-card">

                    <div class="action-icon">🔍</div>
                    Browse Vacancies

                </a>


                <a asp-controller="Home"
                   asp-action="Notifications"
                   class="action-card">

                    <div class="action-icon">🔔</div>
                    Notifications

                </a>

            </div>

        </div>


        <!-- INTERVIEW -->

        @if (scheduledInterview != null &&
             scheduledInterview.Interview != null)
        {
            <div class="dashboard-section">

                <h2>Interview</h2>

                <div class="card p-4">

                    <h3>
                        @scheduledInterview.Vacancy.JobTitle
                    </h3>


                    <p class="mb-2">

                        <strong>Status:</strong>

                        @if (scheduledInterview.Interview.Status == AltriumRecruitmentSystem.Models.InterviewStatus.Scheduled)
                        {
                            <span style="
                                background:#fff3cd;
                                color:#856404;
                                padding:5px 12px;
                                border-radius:15px;
                                font-weight:600;">
                                Scheduled
                            </span>
                        }
                        else if (scheduledInterview.Interview.Status == AltriumRecruitmentSystem.Models.InterviewStatus.Completed)
                        {
                            <span style="
                                background:#d4edda;
                                color:#155724;
                                padding:5px 12px;
                                border-radius:15px;
                                font-weight:600;">
                                Completed
                            </span>
                        }
                        else if (scheduledInterview.Interview.Status == AltriumRecruitmentSystem.Models.InterviewStatus.Cancelled)
                        {
                            <span style="
                                background:#f8d7da;
                                color:#721c24;
                                padding:5px 12px;
                                border-radius:15px;
                                font-weight:600;">
                                Cancelled
                            </span>
                        }
                        else if (scheduledInterview.Interview.Status == AltriumRecruitmentSystem.Models.InterviewStatus.NoShow)
                        {
                            <span style="
                                background:#f8d7da;
                                color:#721c24;
                                padding:5px 12px;
                                border-radius:15px;
                                font-weight:600;">
                                No Show
                            </span>
                        }

                    </p>


                    <p class="mb-2">

                        <strong>Date:</strong>

                        @scheduledInterview.Interview.InterviewDate.ToString("dd MMM yyyy")

                    </p>


                    <p class="mb-2">

                        <strong>Time:</strong>

                        @scheduledInterview.Interview.InterviewTime

                    </p>


                    @if (!string.IsNullOrWhiteSpace(
                        scheduledInterview.Interview.Message))
                    {
                        <p class="mb-2">

                            <strong>Message:</strong>

                            @scheduledInterview.Interview.Message

                        </p>
                    }


                    @if (!string.IsNullOrWhiteSpace(
                        scheduledInterview.Interview.GoogleMeetLink)
                        && scheduledInterview.Interview.Status ==
                        AltriumRecruitmentSystem.Models.InterviewStatus.Scheduled)
                    {
                        <p class="mt-3 mb-0">

                            <a href="@scheduledInterview.Interview.GoogleMeetLink"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-warning">

                                Join Google Meet

                            </a>

                        </p>
                    }


                    <!-- FEEDBACK -->

                    @if (scheduledInterview.Interview.Status ==
                         AltriumRecruitmentSystem.Models.InterviewStatus.Completed)
                    {
                        <div style="
                            margin-top:25px;
                            padding:20px;
                            border-radius:12px;
                            background:rgba(255,193,7,0.08);
                            border-left:4px solid #ffc107;">

                            <h4 style="margin-bottom:15px;">
                                📝 Interview Feedback
                            </h4>


                            @if (!string.IsNullOrWhiteSpace(
                                scheduledInterview.Interview.Outcome))
                            {
                                <p class="mb-2">

                                    <strong>Outcome:</strong>

                                    <span style="font-weight:600;">
                                        @scheduledInterview.Interview.Outcome
                                    </span>

                                </p>
                            }


                            @if (!string.IsNullOrWhiteSpace(
                                scheduledInterview.Interview.InterviewerFeedback))
                            {
                                <p class="mb-2">

                                    <strong>Interviewer Feedback:</strong>

                                </p>

                                <div style="
                                    padding:15px;
                                    border-radius:8px;
                                    background:rgba(255,255,255,0.04);
                                    line-height:1.6;">

                                    @scheduledInterview.Interview.InterviewerFeedback

                                </div>
                            }


                            @if (scheduledInterview.Interview.FeedbackSubmittedOn.HasValue)
                            {
                                <p style="
                                    margin-top:12px;
                                    margin-bottom:0;
                                    color:var(--grey);">

                                    <strong>Feedback Submitted:</strong>

                                    @scheduledInterview.Interview.FeedbackSubmittedOn.Value.ToString("dd MMM yyyy, hh:mm tt")

                                </p>
                            }

                        </div>
                    }

                </div>

            </div>
        }


        <!-- RECENT APPLICATIONS -->

        <div class="dashboard-section">

            <h2>Recent Applications</h2>

            <table class="dashboard-table">

                <thead>

                    <tr>
                        <th>Job Title</th>
                        <th>Applied On</th>
                        <th>Status</th>
                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="3"
                                style="color:var(--grey);">

                                You haven't applied to any vacancies yet.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var app in Model.Take(5))
                        {
                            <tr>

                                <td>
                                    @app.Vacancy.JobTitle
                                </td>

                                <td>
                                    @app.AppliedOn.ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    <span class="status-pill @StatusClass(app.Status)">
                                        @app.Status
                                    </span>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>


            <a asp-controller="Home"
               asp-action="MyApplications"
               class="view-all-link">

                View All Applications →

            </a>

        </div>

    </main>

</div>