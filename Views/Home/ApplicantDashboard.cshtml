@{
    ViewData["Title"] = "Applicant Dashboard";
    var fullName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
    var firstName = fullName.Split(' ')[0];
    var initials = string.Join("", fullName.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));
}

<div class="dashboard-layout">

    <aside class="dashboard-sidebar">
        <a href="#" class="sidebar-link active">Dashboard</a>
        <a asp-controller="Home" asp-action="CompleteProfile" class="sidebar-link">Profile</a>
        <a asp-controller="Home" asp-action="UploadCV" class="sidebar-link">Upload CV</a>
        <a asp-controller="Home" asp-action="BrowseVacancies" class="sidebar-link">Vacancies</a>
        <a asp-controller="Home" asp-action="MyApplications" class="sidebar-link">Applications</a>
        <a href="#" class="sidebar-link">Notifications</a>
        <a asp-controller="Home" asp-action="Logout" class="sidebar-link">Logout</a>
    </aside>

    <main class="dashboard-main">

        <div class="dashboard-welcome">
            <h1>Welcome, @firstName!</h1>

            <div class="dashboard-user">
                <div class="dashboard-avatar">@initials</div>
                @fullName · Applicant
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">3</div>
                <div class="stat-label">Applications</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">1</div>
                <div class="stat-label">Under Review</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">1</div>
                <div class="stat-label">Shortlisted</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">0</div>
                <div class="stat-label">Rejected</div>
            </div>
        </div>

        <div class="dashboard-section">
            <h2>Quick Actions</h2>
            <div class="quick-actions">
                <a asp-controller="Home" asp-action="CompleteProfile" class="action-card">
                    <div class="action-icon">👤</div>
                    Complete Profile
                </a>
                <a asp-controller="Home" asp-action="UploadCV" class="action-card">
                    <div class="action-icon">⬆</div>
                    Upload CV
                </a>
                <a asp-controller="Home" asp-action="BrowseVacancies" class="action-card">
                    <div class="action-icon">🔍</div>
                    Browse Vacancies
                </a>
            </div>
        </div>

        <div class="dashboard-section">
            <h2>Recent Applications</h2>

            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Job Title</th>
                        <th>Applied On</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Software Engineer</td>
                        <td>20 May 2025</td>
                        <td><span class="status-pill status-applied">Applied</span></td>
                    </tr>
                    <tr>
                        <td>Business Analyst</td>
                        <td>18 May 2025</td>
                        <td><span class="status-pill status-review">Under Review</span></td>
                    </tr>
                    <tr>
                        <td>QA Engineer</td>
                        <td>16 May 2025</td>
                        <td><span class="status-pill status-shortlisted">Shortlisted</span></td>
                    </tr>
                </tbody>
            </table>

            <a asp-controller="Home" asp-action="MyApplications" class="view-all-link">View All Applications →</a>
        </div>

    </main>

</div>