@model AltriumRecruitmentSystem.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-card">

        <div class="login-icon">
            <div class="lock-shackle"></div>
            <div class="lock-body"></div>
        </div>

        <h1>Welcome Back!</h1>

        <p class="login-subtitle">
            Login to your account
        </p>

        <div asp-validation-summary="All" style="color:#f85149;font-size:13px;margin-bottom:15px;"></div>

        <form asp-controller="Home" asp-action="Login" method="post">

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" placeholder="Enter email address">
                <span asp-validation-for="Email" style="color:#f85149;font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label>Password</label>
                <div class="password-wrapper">
                    <input asp-for="Password" type="password" placeholder="Enter password">
                    <button type="button" class="password-toggle">👁</button>
                </div>
                <span asp-validation-for="Password" style="color:#f85149;font-size:12px;"></span>
            </div>

            <a href="#" class="forgot-password">Forgot Password?</a>

            <button class="login-button" type="submit">
                Login
            </button>

        </form>

        <p class="register-text">
            Don't have an account?
            <a asp-controller="Home" asp-action="Register">Register</a>
        </p>

    </div>

</div>