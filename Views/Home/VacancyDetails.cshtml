@model AltriumRecruitmentSystem.Models.VacancyDetailsViewModel

@{
    ViewData["Title"] = "Vacancy Details";
    var fullName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
    var initials = string.Join("", fullName.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));
}

<div class="dashboard-layout">

    <aside class="dashboard-sidebar">
        <a asp-controller="Home" asp-action="ApplicantDashboard" class="sidebar-link">Dashboard</a>
        <a asp-controller="Home" asp-action="CompleteProfile" class="sidebar-link">Profile</a>
        <a asp-controller="Home" asp-action="UploadCV" class="sidebar-link">Upload CV</a>
        <a asp-controller="Home" asp-action="BrowseVacancies" class="sidebar-link active">Vacancies</a>
        <a asp-controller="Home" asp-action="MyApplications" class="sidebar-link">Applications</a>
        <a href="#" class="sidebar-link">Notifications</a>
        <a asp-controller="Home" asp-action="Logout" class="sidebar-link">Logout</a>
    </aside>

    <main class="dashboard-main">

        <a asp-controller="Home" asp-action="BrowseVacancies" class="back-link">← Back to Vacancies</a>

        <div class="profile-card">

            <div class="vacancy-detail-header">
                <h1>@Model.Vacancy.JobTitle</h1>

                <div class="vacancy-detail-meta">
                    <div class="meta-item">
                        <div class="meta-label">Department</div>
                        <div class="meta-value">@Model.Vacancy.Department</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Location</div>
                        <div class="meta-value">@Model.Vacancy.Location</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Employment Type</div>
                        <div class="meta-value">@Model.Vacancy.EmploymentType</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Posted On</div>
                        <div class="meta-value">@Model.Vacancy.PostedOn.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            </div>

            <div class="vacancy-detail-body">

                <h2>Job Description</h2>
                <p>@Model.Vacancy.Description</p>

                <h2>Requirements</h2>
                <ul class="requirements-list">
                    @foreach (var line in Model.Vacancy.Requirements.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <li>@line.Trim()</li>
                    }
                </ul>

            </div>

            @if (Model.AlreadyApplied)
            {
                <div class="success-banner">
                    ✓ You have already applied for this vacancy.
                </div>
            }
            else
            {
                <form asp-controller="Home" asp-action="ApplyForVacancy" method="post">
                    <input type="hidden" name="vacancyId" value="@Model.Vacancy.VacancyId" />
                    <button type="submit" class="apply-button">Apply for this Vacancy</button>
                </form>
            }

            @if (Model.JustApplied)
            {
                <div class="success-banner">
                    ✓ Your application has been submitted successfully.
                </div>
            }

        </div>

    </main>

</div>