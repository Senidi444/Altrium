@{
    ViewData["Title"] = "About Us";
}

<div class="info-page">
    <h1>About Altrium</h1>
    <p>
        Altrium is a modern recruitment platform built to connect talented job seekers with the
        companies looking to hire them. We believe finding the right role — or the right candidate —
        shouldn't be complicated.
    </p>
    <p>
        Our platform brings applicants, recruiters, and hiring teams together in one place, making
        the entire recruitment journey — from browsing vacancies to scheduling interviews — simple,
        transparent, and efficient.
    </p>
    <p>
        Whether you're taking the next step in your career or looking to build your team, Altrium
        is here to help you get there.
    </p>
</div>