@model AltriumRecruitmentSystem.Models.User

@{
    ViewData["Title"] = "Upload CV";
    var fullName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
    var initials = string.Join("", fullName.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));
}

<div class="dashboard-layout">

    <aside class="dashboard-sidebar">
        <a asp-controller="Home" asp-action="ApplicantDashboard" class="sidebar-link">Dashboard</a>
        <a asp-controller="Home" asp-action="CompleteProfile" class="sidebar-link">Profile</a>
        <a href="#" class="sidebar-link active">Upload CV</a>
        <a asp-controller="Home" asp-action="BrowseVacancies" class="sidebar-link">Vacancies</a>
        <a asp-controller="Home" asp-action="MyApplications" class="sidebar-link">Applications</a>
        <a href="#" class="sidebar-link">Notifications</a>
        <a asp-controller="Home" asp-action="Logout" class="sidebar-link">Logout</a>
    </aside>

    <main class="dashboard-main">

        <div class="dashboard-welcome">
            <h1>Upload Your CV</h1>

            <div class="dashboard-user">
                <div class="dashboard-avatar">@initials</div>
                @fullName · Applicant
            </div>
        </div>

        @if (TempData["UploadError"] != null)
        {
            <div class="success-banner" style="background:rgba(248,81,73,0.10);border-color:rgba(248,81,73,0.35);color:#f85149;">
                ⚠ @TempData["UploadError"]
            </div>
        }

        <div class="profile-card">
            <h2>Current CV</h2>

            @if (!string.IsNullOrEmpty(Model.CvFileName))
            {
                <div class="current-cv">
                    <div class="cv-file-info">
                        <div class="cv-file-icon">PDF</div>
                        <div>
                            <div class="cv-file-name">@Model.CvFileName</div>
                            <div class="cv-file-date">Uploaded on @Model.CvUploadedOn?.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                    <form asp-controller="Home" asp-action="DeleteCV" method="post">
                        <button type="submit" class="cv-delete-button">Delete</button>
                    </form>
                </div>
            }
            else
            {
                <p style="color:var(--grey);font-size:14px;">No CV uploaded yet.</p>
            }
        </div>

        <div class="profile-card">
            <h2>Upload New CV</h2>

            <form asp-controller="Home" asp-action="UploadCV" method="post" enctype="multipart/form-data">

                <div class="upload-dropzone">
                    <div class="upload-icon">⬆</div>
                    <div class="upload-text">Drag and drop your file here</div>
                    <div class="upload-subtext">or</div>
                    <input type="file" name="CvFile" accept=".pdf" style="margin-top:10px;color:var(--white);">
                    <div class="upload-subtext" style="margin-top:10px;">
                        Accepted Format: PDF only · Maximum File Size: 5 MB
                    </div>
                </div>

                <button type="submit" class="upload-cv-button">Upload CV</button>
            </form>
        </div>

    </main>

</div>