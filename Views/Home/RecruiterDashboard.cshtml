@model List<AltriumRecruitmentSystem.Models.JobApplication>

@{
    ViewData["Title"] = "Recruiter Dashboard";
    var fullName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
    var initials = string.Join("", fullName.Split(' ').Where(n => n.Length > 0).Select(n => n[0]));

    string StatusClass(AltriumRecruitmentSystem.Models.ApplicationStatus status) => status switch
    {
        AltriumRecruitmentSystem.Models.ApplicationStatus.Applied => "status-applied",
        AltriumRecruitmentSystem.Models.ApplicationStatus.UnderReview => "status-review",
        AltriumRecruitmentSystem.Models.ApplicationStatus.Shortlisted => "status-shortlisted",
        AltriumRecruitmentSystem.Models.ApplicationStatus.Rejected => "status-rejected",
        _ => "status-applied"
    };
}

<div class="dashboard-layout">

    <aside class="dashboard-sidebar">
        <a href="#" class="sidebar-link active">Dashboard</a>
        <a asp-controller="Home" asp-action="VacancyManagement" class="sidebar-link">Vacancies</a>
        <a asp-controller="Home" asp-action="ApplicantsManagement" class="sidebar-link">Applications</a>
        <a asp-controller="Home" asp-action="ScheduleInterview" class="sidebar-link">Interviews</a>
        <a asp-controller="Home" asp-action="Logout" class="sidebar-link">Logout</a>
    </aside>

    <main class="dashboard-main">

        <div class="dashboard-welcome">
            <h1>Welcome, @fullName.Split(' ')[0]!</h1>

            <div class="dashboard-user">
                <div class="dashboard-avatar">@initials</div>
                @fullName · Recruiter
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">@ViewBag.TotalVacancies</div>
                <div class="stat-label">Total Vacancies</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@ViewBag.TotalApplicants</div>
                <div class="stat-label">Total Applicants</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@ViewBag.NewApplicants</div>
                <div class="stat-label">New Applicants</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@ViewBag.ShortlistedCount</div>
                <div class="stat-label">Shortlisted</div>
            </div>
        </div>

        <div class="dashboard-section">
            <h2>Recent Applications</h2>

            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Applicant</th>
                        <th>Job Title</th>
                        <th>Applied On</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" style="color:var(--grey);">No applications yet.</td>
                        </tr>
                    }
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td>@app.User.FirstName @app.User.LastName</td>
                            <td>@app.Vacancy.JobTitle</td>
                            <td>@app.AppliedOn.ToString("dd MMM yyyy")</td>
                            <td><span class="status-pill @StatusClass(app.Status)">@app.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>

            <a asp-controller="Home" asp-action="ApplicantsManagement" class="view-all-button">View All Applicants</a>
        </div>

    </main>

</div>