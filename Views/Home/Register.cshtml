@model AltriumRecruitmentSystem.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="register-page">

    <div class="register-card">

        <div class="register-icon">
            <div class="person-head"></div>
            <div class="person-body"></div>
        </div>

        <h1>Create Your Account</h1>

        <p class="register-subtitle">
            Join Altrium and discover your next career opportunity.
        </p>

        <form asp-controller="Home" asp-action="Register" method="post">

            <div class="form-group">
                <label>First Name</label>
                <input asp-for="FirstName" placeholder="Enter first name">
                <span asp-validation-for="FirstName" style="color:#f85149;font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label>Last Name</label>
                <input asp-for="LastName" placeholder="Enter last name">
                <span asp-validation-for="LastName" style="color:#f85149;font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" placeholder="Enter email address">
                <span asp-validation-for="Email" style="color:#f85149;font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label>Password</label>
                <div class="password-wrapper">
                    <input asp-for="Password" type="password" placeholder="Enter password">
                    <button type="button" class="password-toggle">👁</button>
                </div>
                <span asp-validation-for="Password" style="color:#f85149;font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label>Confirm Password</label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm password">
                    <button type="button" class="password-toggle">👁</button>
                </div>
                <span asp-validation-for="ConfirmPassword" style="color:#f85149;font-size:12px;"></span>
            </div>

            <button class="register-button" type="submit">
                Register
            </button>

        </form>

        <p class="login-text">
            Already have an account?
            <a asp-controller="Home" asp-action="Login">Login</a>
        </p>

    </div>

</div>