@model AltriumRecruitmentSystem.Models.CreateVacancyViewModel

@{
    ViewData["Title"] = "Create Vacancy";
}

<div class="dashboard-layout">

    <aside class="dashboard-sidebar">
        <a asp-controller="Home" asp-action="RecruiterDashboard" class="sidebar-link">Dashboard</a>
        <a asp-controller="Home" asp-action="VacancyManagement" class="sidebar-link active">Vacancies</a>
        <a asp-controller="Home" asp-action="ApplicantsManagement" class="sidebar-link">Applications</a>
        <a asp-controller="Home" asp-action="ScheduleInterview" class="sidebar-link">Interviews</a>
        <a asp-controller="Home" asp-action="Logout" class="sidebar-link">Logout</a>
    </aside>

    <main class="dashboard-main">

        <div class="table-header-row">
            <h1>Create Vacancy</h1>
        </div>

        <div class="profile-card" style="max-width:700px;">

            <form asp-controller="Home" asp-action="CreateVacancy" method="post">

                <div class="form-group">
                    <label>Job Title</label>
                    <input asp-for="JobTitle" placeholder="e.g. Software Engineer">
                    <span asp-validation-for="JobTitle" style="color:#f85149;font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <label>Department</label>
                    <input asp-for="Department" placeholder="e.g. Engineering">
                </div>

                <div class="form-group">
                    <label>Location</label>
                    <input asp-for="Location" placeholder="e.g. Colombo, Sri Lanka">
                </div>

                <div class="form-group">
                    <label>Employment Type</label>
                    <select asp-for="EmploymentType">
                        <option>Full-Time</option>
                        <option>Part-Time</option>
                        <option>Contract</option>
                        <option>Internship</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Job Description</label>
                    <textarea asp-for="Description" placeholder="Describe the role..."></textarea>
                </div>

                <div class="form-group">
                    <label>Requirements (one per line)</label>
                    <textarea asp-for="Requirements" placeholder="BSc in Computer Science&#10;Proficiency in C#&#10;Good communication skills"></textarea>
                </div>

                <button type="submit" class="save-profile-button">Create Vacancy</button>

            </form>

        </div>

    </main>

</div>